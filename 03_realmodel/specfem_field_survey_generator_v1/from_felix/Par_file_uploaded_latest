#
# Simulation input parameters
# Mod 40: Three-layer Suite 40 model WITH void. Flat topography. 200m grid. Shot at x=49.5m.
#         Analog of Mod 30 but with new three-layer structure (Suite 40).
#
# Suite 40 layer structure (vs. Suite 30 two-limestone-layer structure):
#   Suite 30:  sat. limestone (Vp=2100) / unsat. limestone (Vp=1150) / sediment
#   Suite 40:  lower limestone (Vp=2900) / upper limestone (Vp=2200) / sediment
#
# Changes from Mod 30:
#   Mat 1: sat. limestone (Vp=2100, Vs=700, rho=2280) --> lower limestone (Vp=2900, Vs=700, rho=2280)
#   Mat 2: unsat. limestone (Vp=1150, Vs=400, rho=2050) --> upper limestone (Vp=2200, Vs=450, rho=2050)
#   Mat 3: sediment (unchanged: Vp=350, Vs=200, rho=1600)
#   Mat 4: void (unchanged: Vp=1500, Vs=0, rho=1000)
#   Region 1: rows 1-84 --> rows 1-66   (lower limestone, depth 17-50m, z=0-33m)
#   Region 2: rows 85-96 --> rows 67-94  (upper limestone, depth 3-17m, z=33-47m)
#   Region 3: rows 97-100 --> rows 95-100 (sediment, depth 0-3m, z=47-50m)
#   Region 4: unchanged (cols 191-210, rows 61-70; void spans both limestone layers)
#   title updated
#   interfacesfile renamed to interfaces_mod40_flat.dat (same geometry)
#   All other parameters identical to Mod 30.
#
# Note on void spanning two layers:
#   Void rows 61-70 (z=30-35m, depth 15-20m):
#     Rows 61-66: within lower limestone zone (Mat 4 overrides Mat 1)
#     Rows 67-70: within upper limestone zone (Mat 4 overrides Mat 2)
#   SPECFEM2D regions are applied in order; Region 4 (void) is last and overrides
#   whatever layer it falls in. The void is still a single rectangular block.
#
# Relationship to other models:
#   Mod 30: Suite 30, WITH void, shot x=49.5m  <-- prior version (2-limestone-layer)
#   Mod 40: Suite 40, WITH void, shot x=49.5m  <-- this model  (3-layer, new velocities)
#   Mod 41: Suite 40, NO void,   shot x=49.5m  <-- baseline companion
#   Mod 42: Suite 40, WITH void, shot x=89.5m  <-- near-void shot
#   Mod 43: Suite 40, NO void,   shot x=89.5m  <-- near-void baseline
#
# Model geometry:
#   Grid: nx=400 (0.5m elements), nz=100 (0.5m elements)
#   x range: 0 to 200m; z range: 0 to 50m; flat free surface at z=50m
#
# Material zones (row/col counting from bottom-left; row 1=bottom, col 1=left):
#   Region 1: cols 1-400, rows   1- 66 --> lower limestone  (Material 1)
#   Region 2: cols 1-400, rows  67- 94 --> upper limestone  (Material 2)
#   Region 3: cols 1-400, rows  95-100 --> sediment         (Material 3)
#   Region 4: cols 191-210, rows 61-70 --> water-filled void (Material 4)
#     (Region 4 applied last; overrides Region 1 and/or Region 2 within void rectangle)
#
# Layer boundaries (depth below 50m free surface):
#   Sediment:        depth  0- 3m  z=47-50m  rows  95-100
#   Upper limestone: depth  3-17m  z=33-47m  rows  67- 94
#   Lower limestone: depth 17-50m  z= 0-33m  rows   1- 66
#
# Void geometry:
#   x = 95-105m, z = 30-35m (depth 15-20m below 50m surface)
#   cols 191-210, rows 61-70
#
# Source location:
#   xs=49.5m, source_surf=.true. --> z=50m (flat surface).
#   Source is 50.5m left of void centre (x=100m).
#
# Receiver array:
#   171 geophones at 1m spacing, x=15m to x=185m.
#   Source at x=49.5m between receivers at x=49m and x=50m.
#   Offsets: -34.5m (x=15m) to +135.5m (x=185m).
#   Void at x=95-105m: positive offsets +45.5 to +55.5m from source.
#
# Materials:
#   Mat 1 lower limestone:  Vp=2900, Vs= 700, rho=2280 kg/m3  Qkappa=70, Qmu=40
#   Mat 2 upper limestone:  Vp=2200, Vs= 450, rho=2050 kg/m3  Qkappa=50, Qmu=20
#   Mat 3 sediment:         Vp= 350, Vs= 200, rho=1600 kg/m3  Qkappa=40, Qmu=15
#   Mat 4 water void:       Vp=1500, Vs=   0, rho=1000 kg/m3  Qkappa=9999, Qmu=9999
#
# Stability: dt=1.0e-5s, dx=dz=0.5m, Vp_max=2900 m/s
#   dt_crit ~ 0.45*0.5/2900 ~ 7.76e-5 s >> dt=1.0e-5 s --> stable
#   Vs_min=200 m/s (sediment), f0=50 Hz: lambda_S=4.0m=8 elements --> well resolved
#
# PML: NELEM_PML_THICKNESS=24 --> 24 x 0.5m = 12m physical PML
#   At 50 Hz, surface wave lambda ~3.7m. PML=12m = 3.2 lambda --> adequate.
#   Left  PML: x=0  to x=12m  (inner edge at x=12m)
#   Right PML: x=188m to x=200m (inner edge at x=188m)
#
# NPROC = 4 (MPI parallel)
# ATTENUATION_VISCOELASTIC = .true.
# READ_VELOCITIES_AT_f0 = .true.  (velocities defined at ATTENUATION_f0_REFERENCE=100 Hz)
#
#-----------------------------------------------------------

title                           = Mod40: 3-layer Suite40 WITH void, flat topo, 200m grid, shot x=49.5m, 0.5m cells, f0=50Hz, 400ms

SIMULATION_TYPE                 = 1
NOISE_TOMOGRAPHY                = 0
SAVE_FORWARD                    = .false.

NPROC                           = 4

#-----------------------------------------------------------
#
# Time stepping
#
# dt=1.0e-5s, NSTEP=40000 --> total time = 0.400s
# Images every 500 steps = 5.0ms per frame
# Total wavefield images: 40000/500 = 80
#
#-----------------------------------------------------------
NSTEP                           = 40000
DT                              = 1.0d-5

time_stepping_scheme            = 1
P_SV                            = .true.
AXISYM                          = .false.

#-----------------------------------------------------------
# Mesh
#-----------------------------------------------------------

PARTITIONING_TYPE               = 3
NGNOD                           = 9              # quadratic elements
setup_with_binary_database      = 0
MODEL                           = default
SAVE_MODEL                      = default

#-----------------------------------------------------------
# Attenuation
#
# ATTENUATION_f0_REFERENCE = 100 Hz: velocities in this file are phase velocities
# at 100 Hz. Source frequency (50 Hz) is independent of this reference.
#-----------------------------------------------------------

ATTENUATION_VISCOELASTIC        = .true.
ATTENUATION_VISCOACOUSTIC       = .false.
N_SLS                           = 3
ATTENUATION_f0_REFERENCE        = 100.0
READ_VELOCITIES_AT_f0           = .true.
USE_SOLVOPT                     = .false.
ATTENUATION_PORO_FLUID_PART     = .false.
Q0_poroelastic                  = 1
freq0_poroelastic                = 10
UNDO_ATTENUATION_AND_OR_PML     = .false.
NT_DUMP_ATTENUATION              = 500
NO_BACKWARD_RECONSTRUCTION      = .false.

#-----------------------------------------------------------
# Sources
#-----------------------------------------------------------

NSOURCES                        = 1
force_normal_to_surface         = .false.
initialfield                    = .false.
add_Bielak_conditions_bottom    = .false.
add_Bielak_conditions_right     = .false.
add_Bielak_conditions_top       = .false.
add_Bielak_conditions_left      = .false.
ACOUSTIC_FORCING                = .false.
noise_source_time_function_type = 4
write_moving_sources_database   = .false.

#-----------------------------------------------------------
# Receivers
#
# 171 geophones at 1m spacing, x=15m to x=185m.
# Array positioned 3m outside the PML inner edges (x=12m left, x=188m right).
# Source at x=49.5m between receivers at x=49m and x=50m.
# Offsets: -34.5m (x=15m) to +135.5m (x=185m).
# Void at x=95-105m: positive offsets +45.5 to +55.5m from source.
#-----------------------------------------------------------

seismotype                      = 2
NTSTEP_BETWEEN_OUTPUT_SEISMOS   = 20000
NTSTEP_BETWEEN_OUTPUT_SAMPLE    = 10
USE_TRICK_FOR_BETTER_PRESSURE   = .false.
USER_T0                         = 0.0d0
save_ASCII_seismograms          = .false.
save_binary_seismograms_single  = .false.
save_binary_seismograms_double  = .false.
SU_FORMAT                       = .true.

use_existing_STATIONS           = .false.

nreceiversets                   = 1
anglerec                        = 0.d0
rec_normal_to_surface           = .false.
nrec                            = 171
xdeb                            = 15.
zdeb                            = 50.
xfin                            = 185.
zfin                            = 50.
record_at_surface_same_vertical = .true.

#-----------------------------------------------------------
# adjoint kernels
#-----------------------------------------------------------

save_ASCII_kernels              = .true.
NTSTEP_BETWEEN_COMPUTE_KERNELS  = 1
APPROXIMATE_HESS_KL             = .false.

#-----------------------------------------------------------
# Boundary conditions
#
# NELEM_PML_THICKNESS=24: 24 x 0.5m = 12m physical PML thickness.
# Left  PML: x=0  to x=12m  (inner edge at x=12m)
# Right PML: x=188m to x=200m (inner edge at x=188m)
# Receivers run from x=15 to x=185m --> 3m buffer outside PML on each side.
#-----------------------------------------------------------

PML_BOUNDARY_CONDITIONS         = .true.
NELEM_PML_THICKNESS             = 24
ROTATE_PML_ACTIVATE             = .false.
ROTATE_PML_ANGLE                = 30.
K_MIN_PML                       = 1.0d0
K_MAX_PML                       = 1.0d0
damping_change_factor_acoustic  = 0.5d0
damping_change_factor_elastic   = 1.0d0
PML_PARAMETER_ADJUSTMENT        = .false.
STACEY_ABSORBING_CONDITIONS     = .false.
ADD_PERIODIC_CONDITIONS         = .false.
PERIODIC_HORIZ_DIST             = 200.d0

#-----------------------------------------------------------
#
# Velocity and density models
#
# Material 1: Lower limestone (z=0-33m, depth 17-50m)
#   Vp=2900, Vs=700,  rho=2280 kg/m3,  Qkappa=70, Qmu=40
#
# Material 2: Upper limestone (z=33-47m, depth 3-17m)
#   Vp=2200, Vs=450,  rho=2050 kg/m3,  Qkappa=50, Qmu=20
#
# Material 3: Sediment (z=47-50m, depth 0-3m)
#   Vp= 350, Vs=200,  rho=1600 kg/m3,  Qkappa=40, Qmu=15
#
# Material 4: Water-filled void (acoustic fluid)
#   Vp=1500, Vs=0,    rho=1000 kg/m3,  Qkappa=9999, Qmu=9999 (lossless)
#
#-----------------------------------------------------------

nbmodels                        = 4
1 1 2280.d0 2900.d0  700.d0 0 0  70.d0   40.d0 0 0 0 0 0 0
2 1 2050.d0 2200.d0  450.d0 0 0  50.d0   20.d0 0 0 0 0 0 0
3 1 1600.d0  350.d0  200.d0 0 0  40.d0   15.d0 0 0 0 0 0 0
4 1 1000.d0 1500.d0    0.d0 0 0 9999.d0 9999.d0 0 0 0 0 0 0

TOMOGRAPHY_FILE                 = ./DATA/tomo_file.xyz
read_external_mesh              = .false.

#-----------------------------------------------------------
# PARAMETERS FOR EXTERNAL MESHING (unused)
#-----------------------------------------------------------

mesh_file                       = ./DATA/mesh_file
nodes_coords_file               = ./DATA/nodes_coords_file
materials_file                  = ./DATA/materials_file
free_surface_file                = ./DATA/free_surface_file
axial_elements_file             = ./DATA/axial_elements_file
absorbing_surface_file          = ./DATA/absorbing_surface_file
acoustic_forcing_surface_file   = ./DATA/MSH/Surf_acforcing_Bottom_enforcing_mesh
absorbing_cpml_file             = ./DATA/absorbing_cpml_file
tangential_detection_curve_file = ./DATA/courbe_eros_nodes

#-----------------------------------------------------------
#
# PARAMETERS FOR INTERNAL MESHING
#
# Grid: nx=400 (0.5m elements), nz=100 (0.5m elements), xmax=200m
# Flat free surface; material zones assigned via regions below.
#
# Region assignments (col n: x=(n-1)*0.5 to n*0.5; row n: z=(n-1)*0.5 to n*0.5):
#   Region 1: cols 1-400, rows   1- 66 --> lower limestone (Mat 1)
#   Region 2: cols 1-400, rows  67- 94 --> upper limestone (Mat 2)
#   Region 3: cols 1-400, rows  95-100 --> sediment        (Mat 3)
#   Region 4: cols 191-210, rows 61-70 --> water void      (Mat 4)
#     Void covers x=95-105m, z=30-35m (depth 15-20m)
#     Void spans lower limestone (rows 61-66) and upper limestone (rows 67-70)
#
#-----------------------------------------------------------

interfacesfile                  = ./interfaces_mod40_flat.dat

xmin                            = 0.d0
xmax                            = 200.d0
nx                              = 400

absorbbottom                    = .true.
absorbright                     = .true.
absorbtop                       = .false.
absorbleft                      = .true.

nbregions                       = 4
1 400   1  66  1
1 400  67  94  2
1 400  95 100  3
191 210 61  70  4

#-----------------------------------------------------------
# Display parameters
#-----------------------------------------------------------

NTSTEP_BETWEEN_OUTPUT_INFO      = 3000
output_grid_Gnuplot             = .true.
output_grid_ASCII               = .true.
OUTPUT_ENERGY                   = .false.
NTSTEP_BETWEEN_OUTPUT_ENERGY    = 10
COMPUTE_INTEGRATED_ENERGY_FIELD = .false.

#-----------------------------------------------------------
#
# Movies / images / snapshots
#
# NTSTEP_BETWEEN_OUTPUT_IMAGES = 500 --> one image every 5ms
# Total images: 40000/500 = 80
#
#-----------------------------------------------------------

NTSTEP_BETWEEN_OUTPUT_IMAGES    = 500
cutsnaps                        = 1.

#### for JPEG color images ####
output_color_image              = .true.
imagetype_JPEG                  = 6              # velocity norm
factor_subsample_image          = 1.0d0
USE_CONSTANT_MAX_AMPLITUDE      = .false.
CONSTANT_MAX_AMPLITUDE_TO_USE   = 1.17d4
POWER_DISPLAY_COLOR             = 0.30d0
DRAW_SOURCES_AND_RECEIVERS      = .true.
DRAW_WATER_IN_BLUE              = .true.
USE_SNAPSHOT_NUMBER_IN_FILENAME = .true.

#### for PostScript snapshots ####
output_postscript_snapshot      = .false.
imagetype_postscript            = 1
meshvect                        = .true.
modelvect                       = .false.
boundvect                       = .true.
interpol                        = .true.
pointsdisp                      = 6
subsamp_postscript              = 1
sizemax_arrows                  = 1.d0
US_LETTER                       = .false.

#### for wavefield dumps ####
output_wavefield_dumps          = .false.
imagetype_wavefield_dumps       = 1
use_binary_for_wavefield_dumps  = .false.

#-----------------------------------------------------------

NUMBER_OF_SIMULTANEOUS_RUNS     = 1
BROADCAST_SAME_MESH_AND_MODEL   = .true.
GPU_MODE                        = .false.
